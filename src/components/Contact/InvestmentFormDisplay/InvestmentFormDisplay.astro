---
import Wrapper from "../../shared/Wrapper.astro";
import InvestmentForm from "../../sharedReact/InvestmentForm/InvestmentForm";
import "./investmentFormDisplay.scss";

const { displayInvestmentForm, title, content } = Astro.props.data;
---

{
  displayInvestmentForm ? (
    <div class="investment-form">
      <Wrapper classes="investment-form-wrapper">
        <div class="investment-form-intro">
          <div class="investment-form-intro-title">
            <h2>{title}</h2>
          </div>
          <div class="investment-form-intro-content" set:html={content} />
        </div>
        <InvestmentForm client:only="react" />
      </Wrapper>
    </div>
  ) : null
}
