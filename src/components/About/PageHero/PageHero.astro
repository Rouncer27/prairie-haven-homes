---
import { Image } from "astro:assets";
import "./pageHero.scss";
import Button from "../../shared/Button.astro";

const { image, title, content, buttonText, buttonLink } = Astro.props.data;
const imageSrc = image?.node?.sourceUrl;
const imagelt = image?.node?.altText || "";
---

<div class="page-hero">
  <div class="page-hero-content">
    <div class="page-hero-content-inner">
      <div>
        <h2>{title}</h2>
      </div>
      <div set:html={content} />
      <div>
        <Button btnstyle="two" ele="a" href={buttonLink.edges[0].node.uri}
          >{buttonText}</Button
        >
      </div>
    </div>
  </div>
  <div class="page-hero-image">
    <Image
      src={imageSrc}
      alt={imagelt}
      format="webp"
      widths={[800, 1200, 1600, 2000]}
      sizes="100vw"
      loading="eager"
      inferSize={true}
      class=""
    />
  </div>
</div>
