---
import Wrapper from "../../shared/Wrapper.astro";
import "./values.scss";

const { title, content } = Astro.props.data;
---

<div class="values">
  <Wrapper classes="values-wrapper">
    <div class="values-title">
      <h2>{title}</h2>
    </div>
    <div class="values-content">
      <div set:html={content} />
    </div>
  </Wrapper>
</div>
