---
// @ts-nocheck
import Wrapper from "../../shared/Wrapper.astro";
import "./stepsProcess.scss";

const { title, steps } = Astro.props.data;
---

<div class="steps-process">
  <Wrapper classes="steps-process-wrapper">
    <div class="steps-process-title">
      <h2>{title}</h2>
    </div>
    {
      steps.map((step) => {
        return (
          <div class="steps-process-step">
            <div class="steps-process-step-title">
              <h3>{step.title}</h3>
            </div>
            <div class="steps-process-step-content" set:html={step.content} />
          </div>
        );
      })
    }
  </Wrapper>
</div>
