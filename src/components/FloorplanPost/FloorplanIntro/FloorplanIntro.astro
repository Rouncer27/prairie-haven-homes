---
import { Image } from "astro:assets";
import Wrapper from "../../shared/Wrapper.astro";
import "./floorplanIntro.scss";

const { title, content, image } = Astro.props.data;

const imageSrc = image.node?.sourceUrl;
const imageAlt = image?.node?.altText || "";
---

<div class="floorplan-intro">
  <Wrapper classes="floorplan-intro-wrapper">
    <div class="floorplan-intro-content">
      <div>
        <h2>{title}</h2>
      </div>
      <div set:html={content} />
    </div>
    <div class="floorplan-intro-image">
      <Image
        src={imageSrc}
        alt={imageAlt}
        format="webp"
        widths={[800, 1200, 1600, 2000]}
        sizes="100vw"
        loading="eager"
        inferSize={true}
        class=""
      />
    </div>
  </Wrapper>
</div>
