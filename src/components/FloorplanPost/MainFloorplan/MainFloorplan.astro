---
import { Image } from "astro:assets";
import Wrapper from "../../shared/Wrapper.astro";
import "./mainFloorplan.scss";

const { floorplan } = Astro.props.data;

const planSrc = floorplan?.node?.sourceUrl;
const palnAlt = floorplan?.node?.altText || "";
---

<div>
  <Wrapper>
    <div>
      <Image
        src={planSrc}
        alt={palnAlt}
        format="webp"
        widths={[800, 1200, 1600, 2000]}
        sizes="100vw"
        loading="eager"
        inferSize={true}
        class=""
      />
    </div>
  </Wrapper>
</div>
