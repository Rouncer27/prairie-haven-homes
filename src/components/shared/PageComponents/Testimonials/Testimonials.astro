---
// @ts-nocheck
import Wrapper from "../../../shared/Wrapper.astro";
import "./testimonials.scss";

const { title } = Astro.props.data;
const { testimonials } = Astro.props;
---

<div class="testimonials">
  <Wrapper classes="testimonials-wrapper">
    <div class="testimonials-title">
      <h2>{title}</h2>
    </div>
    <div class="testimonials-items">
      {
        testimonials.map((testimonial) => {
          return (
            <div class="testimonials-items-testimonial">
              <div
                class="testimonials-items-testimonial-content"
                set:html={testimonial.node.testimonialPost.mainTestimonial}
              />
              <div class="testimonials-items-testimonial-author">
                <p>{testimonial.node.title}</p>
              </div>
            </div>
          );
        })
      }
    </div>
  </Wrapper>
</div>
