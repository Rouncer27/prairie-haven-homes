---
// @ts-nocheck
import { Image } from "astro:assets";
import Wrapper from "../../../shared/Wrapper.astro";
import Button from "../../../shared/Button.astro";
import "./imageGallery.scss";

const {
  gallery: { edges: gallery },
} = Astro.props.data;

const { isFloorplan } = Astro.props;
---

<div class={`image-gallery${isFloorplan ? " image-gallery-floorplan" : ""}`}>
  <Wrapper classes="image-gallery-wrapper">
    {
      isFloorplan ? (
        <div class="image-gallery-title">
          <h2>Gallery For Floorplan</h2>
        </div>
      ) : null
    }
    <div class="image-gallery-container">
      {
        gallery.map((gal) => {
          const imageeSrc = gal?.node?.sourceUrl;
          const imageAlt = gal?.node?.altText || "";
          return (
            <div class="image-gallery-item">
              <Image
                src={imageeSrc}
                alt={imageAlt}
                format="webp"
                widths={[800, 1200, 1600, 2000]}
                sizes="100vw"
                loading="eager"
                inferSize={true}
                class=""
              />
            </div>
          );
        })
      }
    </div>
    <div class="image-gallery-links">
      <Button btnstyle="two" ele="a" href="/home-plans"
        >{isFloorplan ? "Back To" : "See"} Floorplans</Button
      >
      <Button btnstyle="two" ele="a" href="/about">About Us</Button>
    </div>
  </Wrapper>
</div>
