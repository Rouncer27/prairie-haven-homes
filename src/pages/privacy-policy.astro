---
import Wrapper from "../components/shared/Wrapper.astro";
import Layout from "../layouts/Layout.astro";
import HeroIntro from "../components/shared/PageComponents/HeroIntro/HeroIntro.astro";
import MainContent from "../components/PrivacyPolicy/MainContent/MainContent.astro";

import { Page_Seo_Query, Hero_Intro_Query } from "../data/page/queries";
import { Main_Content_Query } from "../data/privacyPolicy/queries";

const response = await fetch(`${import.meta.env.WPGRAPHQL_URL}`, {
  method: "POST",
  headers: {
    "content-type": "application/json",
  },
  body: JSON.stringify({
    query: `
		query privacyPolicyPageQuery {
			page(id: "/privacy-policy", idType: URI) {
				${Page_Seo_Query}

        privacyPolicyPage {
          ${Hero_Intro_Query}
          ${Main_Content_Query}
        }
			}
		}
	`,
  }),
});

const {
  data: {
    page: { seoMetaTags, privacyPolicyPage },
  },
} = await response.json();
---

<Layout
  metaImg={seoMetaTags.seoMetaInformation.metaImage.sourceUrl}
  metaTitle={seoMetaTags.seoMetaInformation.metaTitle}
  metaDescription={seoMetaTags.seoMetaInformation.metaDescription}
>
  <HeroIntro data={privacyPolicyPage.heroIntro} />
  <MainContent data={privacyPolicyPage.mainContent} />
</Layout>
