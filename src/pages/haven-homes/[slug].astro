---
// @ts-nocheck
import Layout from "../../layouts/Layout.astro";
import FloorplansHero from "../../components/FloorplanPost/FloorplansHero/FloorplansHero.astro";
import FloorplanIntro from "../../components/FloorplanPost/FloorplanIntro/FloorplanIntro.astro";

import { Page_Seo_Query, Floorplan_Hero_Query } from "../../data/page/queries";
import {
  Hero_Titles_Query,
  Floorplan_Intro_Query,
} from "../../data/floorPlans/queries";

export async function getStaticPaths() {
  const response = await fetch(`${import.meta.env.WPGRAPHQL_URL}`, {
    method: "POST",
    headers: {
      "content-type": "application/json",
    },
    body: JSON.stringify({
      query: `
        query floorplansQuery {
            floorplans(first: 999999) {
                nodes {
                    uri
                    slug
                    title
                }   
            }
        }
        `,
    }),
  });

  const { data } = await response.json();
  return data.floorplans.nodes.map((floorplan, index) => {
    return {
      params: { slug: `${floorplan.slug}` },
      props: {
        next: index === 0 ? null : data.floorplans.nodes[index - 1],
        prev:
          index === data.floorplans.nodes.length - 1
            ? null
            : data.floorplans.nodes[index + 1],
      },
    };
  });
}

const response = await fetch(`${import.meta.env.WPGRAPHQL_URL}`, {
  method: "POST",
  headers: {
    "content-type": "application/json",
  },
  body: JSON.stringify({
    query: `
    query floorplanQuery($id: ID!) {
        floorplan(idType: SLUG, id: $id) {
            title
            ${Page_Seo_Query}
            floorplanPost {
                ${Hero_Titles_Query}
                ${Floorplan_Intro_Query}
            }            
        }
        ${Floorplan_Hero_Query}
        
    }
    `,
    variables: {
      id: Astro.params["slug"],
    },
  }),
});

const {
  data: {
    floorplan,
    heroImage,
    floorplan: { seoMetaTags, floorplanPost },
  },
} = await response.json();
---

<Layout
  metaImg={seoMetaTags.seoMetaInformation.metaImage.sourceUrl}
  metaTitle={seoMetaTags.seoMetaInformation.metaTitle}
  metaDescription={seoMetaTags.seoMetaInformation.metaDescription}
>
  <FloorplansHero
    data={floorplanPost.heroTitles}
    image={heroImage.floorplanHero.floorplanHeroImage}
  />
  <FloorplanIntro data={floorplanPost.floorplanIntro} />
</Layout>
