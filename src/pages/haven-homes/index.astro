---
import Layout from "../../layouts/Layout.astro";
import HeroIntro from "../../components/shared/PageComponents/HeroIntro/HeroIntro.astro";
import SideSideIntro from "../../components/HavenHomes/SideSideIntro/SideSideIntro.astro";
import KeyFeatures from "../../components/shared/PageComponents/KeyFeatures/KeyFeatures.astro";
import Floorplans from "../../components/HavenHomes/Floorplans/Floorplans.astro";
import Locations from "../../components/shared/PageComponents/Locations/Locations.astro";
import ContentBoxes from "../../components/HavenHomes/ContentBoxes/ContentBoxes.astro";
import Testimonials from "../../components/HavenHomes/Testimonials/Testimonials.astro";

import {
  Page_Seo_Query,
  Hero_Intro_Query,
  Key_Features_Query,
  Locations_Query,
  Testimonials_Query,
} from "../../data/page/queries";

import {
  Side_Side_Intro_Query,
  Floorplans_Query,
  Content_Boxes_Query,
} from "../../data/havenHomes/queries";

const response = await fetch(`${import.meta.env.WPGRAPHQL_URL}`, {
  method: "POST",
  headers: {
    "content-type": "application/json",
  },
  body: JSON.stringify({
    query: `
		query havenHomesPageQuery {
			page(id: "/haven-homes", idType: URI) {
				${Page_Seo_Query}
        havenHomesPage {
          ${Hero_Intro_Query}
          ${Side_Side_Intro_Query}
          ${Key_Features_Query}
          ${Floorplans_Query}
          ${Locations_Query}
          ${Content_Boxes_Query}
          ${Testimonials_Query}
        }
			}

      floorplans(first: 999999) {
          edges {
            node {
              title
              slug
              floorplanPost {
                featuredImage {
                  node {
                      sourceUrl
                      altText
                      mediaDetails {
                          width
                          height
                      }
                  }
                }
                specs
              }
            }
          }
        }


        testimonials(first: 999999) {
          edges {
            node {
              title
              slug
              testimonialPost {
               mainTestimonial
              }
            }
          }
        }


		}
	`,
  }),
});

const {
  data: {
    page: { seoMetaTags, havenHomesPage },
    floorplans,
    testimonials,
  },
} = await response.json();
---

<Layout
  metaImg={seoMetaTags.seoMetaInformation.metaImage.sourceUrl}
  metaTitle={seoMetaTags.seoMetaInformation.metaTitle}
  metaDescription={seoMetaTags.seoMetaInformation.metaDescription}
>
  <HeroIntro data={havenHomesPage.heroIntro} />
  <SideSideIntro data={havenHomesPage.sideSideIntro} />
  <KeyFeatures data={havenHomesPage.keyFeatures} />
  <Floorplans data={havenHomesPage.floorplans} floorplans={floorplans.edges} />
  <Locations data={havenHomesPage.locations} />
  <ContentBoxes data={havenHomesPage.contentBoxes} />
  <Testimonials
    data={havenHomesPage.testimonials}
    testimonials={testimonials.edges}
  />
</Layout>
