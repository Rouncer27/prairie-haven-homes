---
import Layout from "../layouts/Layout.astro";
import HeroIntro from "../components/shared/PageComponents/HeroIntro/HeroIntro.astro";
import ContactInformation from "../components/Contact/ContactInformation/ContactInformation.astro";
import ImagesRow from "../components/Contact/ImagesRow/ImagesRow.astro";
import InvestmentFormDisplay from "../components/Contact/InvestmentFormDisplay/InvestmentFormDisplay.astro";
import ContactFormDisplay from "../components/Contact/ContactFormDisplay/ContactFormDisplay.astro";
import StepsProcess from "../components/shared/PageComponents/StepsProcess/StepsProcess.astro";

import {
  Page_Seo_Query,
  Hero_Intro_Query,
  Steps_Process_Query,
} from "../data/page/queries";
import {
  Contact_Information_Query,
  Images_Row_Query,
  Investment_Form_Display_Query,
  Contact_Form_Display_Query,
} from "../data/contact/queries";

const response = await fetch(`${import.meta.env.WPGRAPHQL_URL}`, {
  method: "POST",
  headers: {
    "content-type": "application/json",
  },
  body: JSON.stringify({
    query: `
		query contactPageQuery {
			page(id: "/contact", idType: URI) {
				${Page_Seo_Query}

        contactPage {
          ${Hero_Intro_Query}
          ${Contact_Information_Query}
          ${Images_Row_Query}
          ${Steps_Process_Query}
          ${Investment_Form_Display_Query}
          ${Contact_Form_Display_Query}
        }
			}
		}
	`,
  }),
});

const {
  data: {
    page: { seoMetaTags, contactPage },
  },
} = await response.json();
---

<Layout
  metaImg={seoMetaTags.seoMetaInformation.metaImage.sourceUrl}
  metaTitle={seoMetaTags.seoMetaInformation.metaTitle}
  metaDescription={seoMetaTags.seoMetaInformation.metaDescription}
>
  <HeroIntro data={contactPage.heroIntro} />
  <ContactInformation data={contactPage.contactInformation} />
  <ImagesRow data={contactPage.imagesRow} />
  <StepsProcess data={contactPage.stepsProcess} />
  <InvestmentFormDisplay data={contactPage.investmentFormDisplay} />
  <ContactFormDisplay data={contactPage.contactFormDisplay} />
</Layout>
